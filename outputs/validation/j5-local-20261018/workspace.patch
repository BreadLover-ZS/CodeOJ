+package com.codeoj.codeojbackendquestionservice.scoreboard;
+
+import com.codeoj.codeojbackendcommon.common.*;
+import com.codeoj.codeojbackendserviceclient.service.UserFeignClient;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.web.bind.annotation.*;
+import javax.servlet.http.HttpServletRequest;
+import java.util.*;
+
+@RestController
+@RequestMapping("/contests/{id}/scoreboard")
+@ConditionalOnProperty(name="codeoj.scoreboard.enabled",havingValue="true")
+public class ScoreboardController {
+    private final ScoreboardService service;private final ScoreboardTransactions transactions;private final UserFeignClient users;
+    public ScoreboardController(ScoreboardService service,ScoreboardTransactions transactions,UserFeignClient users) { this.service=service;this.transactions=transactions;this.users=users; }
+    private long actor(HttpServletRequest http) { return users.getLoginUser(http).getId(); }
+    @GetMapping public BaseResponse<Map<String,Object>> page(@PathVariable long id,@RequestParam(defaultValue="0") int page,
+            @RequestParam(defaultValue="20") int size,@RequestParam(required=false) Long version,HttpServletRequest http) {
+        return ResultUtils.success(service.page(id,page,size,version,actor(http)));
+    }
+    @GetMapping("/operations") public BaseResponse<Map<String,Object>> operations(@PathVariable long id,@RequestParam(defaultValue="0") int page,HttpServletRequest http) {
+        return ResultUtils.success(transactions.operations(id,page,actor(http)));
+    }
+    @PostMapping("/rebuild") public BaseResponse<Map<String,Object>> rebuild(@PathVariable long id,@RequestBody ScoreboardCommand command,HttpServletRequest http) {
+        return ResultUtils.success(transactions.rebuild(id,command,actor(http),false));
+    }
+    @PostMapping("/revise") public BaseResponse<Map<String,Object>> revise(@PathVariable long id,@RequestBody ScoreboardCommand command,HttpServletRequest http) {
+        return ResultUtils.success(transactions.rebuild(id,command,actor(http),true));
+    }
+    @PostMapping("/finish") public BaseResponse<Boolean> finish(@PathVariable long id,@RequestBody ScoreboardCommand command,HttpServletRequest http) {
+        transactions.finish(id,command,actor(http));return ResultUtils.success(true);
+    }
+    @PostMapping("/cache-clear") public BaseResponse<Boolean> clear(@PathVariable long id,@RequestBody ScoreboardCommand command,HttpServletRequest http) {
+        transactions.clearCache(id,command,actor(http));return ResultUtils.success(true);
+    }
+    @PostMapping("/replay") public BaseResponse<Integer> replay(@PathVariable long id,@RequestBody ScoreboardCommand command,HttpServletRequest http) {
+        return ResultUtils.success(transactions.replay(id,command,actor(http)));
+    }
+}
diff --git a/codeoj-backend/codeoj-backend-question-service/src/main/java/com/codeoj/codeojbackendquestionservice/scoreboard/ScoreboardMessaging.java b/codeoj-backend/codeoj-backend-question-service/src/main/java/com/codeoj/codeojbackendquestionservice/scoreboard/ScoreboardMessaging.java
new file mode 100644
index 0000000..0c3c435
--- /dev/null
+++ b/codeoj-backend/codeoj-backend-question-service/src/main/java/com/codeoj/codeojbackendquestionservice/scoreboard/ScoreboardMessaging.java
@@ -0,0 +1,36 @@
+package com.codeoj.codeojbackendquestionservice.scoreboard;
+
+import com.codeoj.codeojbackendquestionservice.submission.outbox.*;
+import org.springframework.amqp.core.*;
+import org.springframework.amqp.rabbit.connection.ConnectionFactory;
+import org.springframework.amqp.rabbit.core.RabbitTemplate;
+import org.springframework.amqp.rabbit.config.SimpleRabbitListenerContainerFactory;
+import org.springframework.boot.autoconfigure.amqp.SimpleRabbitListenerContainerFactoryConfigurer;
+import org.springframework.context.annotation.*;
+import org.springframework.scheduling.annotation.Scheduled;
+
+@Configuration
+@org.springframework.boot.autoconfigure.condition.ConditionalOnProperty(name="codeoj.scoreboard.enabled",havingValue="true")
+public class ScoreboardMessaging {
+    @org.springframework.beans.factory.annotation.Value("${codeoj.reliable-judge.enabled:false}") private boolean reliableEnabled;
+    @javax.annotation.PostConstruct public void validate() { if(!reliableEnabled) { throw new IllegalStateException("SCOREBOARD_REQUIRES_RELIABLE_JUDGE"); } }
+    public static final String EXCHANGE="codeoj.scoreboard.v1.exchange",QUEUE="codeoj.scoreboard.v1.queue";
+    @Bean public Declarables scoreboardTopology() {
+        DirectExchange exchange=new DirectExchange(EXCHANGE,true,false),dead=new DirectExchange("codeoj.scoreboard.v1.dlx",true,false);
+        Queue work=QueueBuilder.durable(QUEUE).deadLetterExchange(dead.getName()).deadLetterRoutingKey("quarantine").build(),quarantine=QueueBuilder.durable("codeoj.scoreboard.v1.quarantine").build();
+        return new Declarables(exchange,dead,work,quarantine,BindingBuilder.bind(work).to(exchange).with("result"),BindingBuilder.bind(quarantine).to(dead).with("quarantine"));
+    }
+    @Bean public RabbitTemplate scoreboardTemplate(ConnectionFactory factory) { RabbitTemplate template=new RabbitTemplate(factory);template.setMandatory(true);template.setReturnsCallback(returned->{});return template; }
+    @Bean public SimpleRabbitListenerContainerFactory scoreboardListenerFactory(SimpleRabbitListenerContainerFactoryConfigurer configurer,ConnectionFactory connection) {
+        SimpleRabbitListenerContainerFactory factory=new SimpleRabbitListenerContainerFactory();configurer.configure(factory,connection);factory.setPrefetchCount(10);factory.setConcurrentConsumers(1);factory.setMaxConcurrentConsumers(1);factory.setAcknowledgeMode(AcknowledgeMode.MANUAL);return factory;
+    }
+    @Bean public Relay scoreboardRelay(ScoreboardTransactions transactions,OutboxStore store,@org.springframework.beans.factory.annotation.Qualifier("scoreboardTemplate") RabbitTemplate rabbit) { return new Relay(transactions,store,rabbit); }
+    public static class Relay {
+        private final ScoreboardTransactions transactions;private final OutboxStore store;private final RabbitTemplate rabbit;
+        public Relay(ScoreboardTransactions transactions,OutboxStore store,RabbitTemplate rabbit) { this.transactions=transactions;this.store=store;this.rabbit=rabbit; }
+        @Scheduled(fixedDelay=1000) public void tick() {
+            transactions.recoverPublications();
+            for(String id:store.due("JUDGE_RESULT")) { OutboxStore.Publication p=store.claim(id,"JUDGE_RESULT");if(p!=null) { OutboxDelivery.publish(store,rabbit,p,EXCHANGE,"result"); } }
+        }
+    }
+}
