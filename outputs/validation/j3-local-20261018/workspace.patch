@@ -0,0 +1,41 @@
+package com.codeoj.codeojbackendquestionservice.submission.outbox;
+
+import org.springframework.amqp.core.*;
+import org.springframework.amqp.rabbit.connection.CorrelationData;
+import org.springframework.amqp.rabbit.core.RabbitTemplate;
+import org.springframework.beans.factory.annotation.Qualifier;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.scheduling.annotation.Scheduled;
+import org.springframework.stereotype.Component;
+import lombok.extern.slf4j.Slf4j;
+import java.nio.charset.StandardCharsets;
+
+@Component
+@Slf4j
+@ConditionalOnProperty(name="codeoj.reliable-judge.enabled",havingValue="true")
+public class OutboxRelay {
+    private final OutboxStore store;
+    private final RabbitTemplate rabbit;
+    public OutboxRelay(OutboxStore store,@Qualifier("reliableJudgeTemplate") RabbitTemplate rabbit) { this.store=store;this.rabbit=rabbit; }
+    @Scheduled(fixedDelayString="${codeoj.reliable-judge.relay-delay-ms:1000}")
+    public void tick() {
+        for(String eventId:store.due()) {
+            OutboxStore.Publication publication=store.claim(eventId);
+            if(publication==null) { continue; }
+            MessageProperties properties=new MessageProperties();
+            properties.setContentType(MessageProperties.CONTENT_TYPE_JSON);properties.setDeliveryMode(MessageDeliveryMode.PERSISTENT);
+            properties.setMessageId(eventId);properties.setCorrelationId(publication.getToken());
+            CorrelationData correlation=new CorrelationData(publication.getToken());
+            correlation.getFuture().addCallback(confirm -> {
+                boolean returned=correlation.getReturned()!=null;
+                store.record(eventId,publication.getToken(),confirm.isAck()?"ACK":"NACK",returned,returned?"UNROUTABLE":confirm.isAck()?null:"BROKER_NACK");
+            }, error -> store.record(eventId,publication.getToken(),"UNKNOWN",false,"CONFIRM_RESULT_UNKNOWN"));
+            try {
+                rabbit.send("codeoj.judge.v1.exchange","judge",new Message(publication.getPayload().getBytes(StandardCharsets.UTF_8),properties),correlation);
+            } catch(RuntimeException e) {
+                store.record(eventId,publication.getToken(),"UNKNOWN",false,"SEND_RESULT_UNKNOWN");
+                log.warn("Judge publish result unknown: eventId={}",eventId);
+            }
+        }
+    }
+}
diff --git a/codeoj-backend/codeoj-backend-question-service/src/main/java/com/codeoj/codeojbackendquestionservice/submission/outbox/OutboxStore.java b/codeoj-backend/codeoj-backend-question-service/src/main/java/com/codeoj/codeojbackendquestionservice/submission/outbox/OutboxStore.java
