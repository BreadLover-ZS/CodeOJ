diff --git a/codeoj-backend/codeoj-backend-question-service/src/test/java/com/codeoj/codeojbackendquestionservice/submission/outbox/OutboxRelayTest.java b/codeoj-backend/codeoj-backend-question-service/src/test/java/com/codeoj/codeojbackendquestionservice/submission/outbox/OutboxRelayTest.java
new file mode 100644
index 0000000..37c5d5f
--- /dev/null
