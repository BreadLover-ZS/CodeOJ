+<template>
+  <div class="manage-contests">
+    <div class="app-card section">
+      <a-space
+        ><h2>比赛管理</h2>
+        <a-button :loading="busy" @click="load">刷新</a-button
+        ><a-button @click="newDraft">新建草稿</a-button></a-space
+      >
